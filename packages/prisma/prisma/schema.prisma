generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["auth", "public"]
}

model auto_tune_log {
  id                     Int       @id @default(autoincrement())
  profile_key            String
  tuned_at               DateTime? @default(now()) @db.Timestamptz(6)
  window_start           DateTime  @db.Date
  window_end             DateTime  @db.Date
  settled_bets_in_window Int
  params_before          Json
  params_after           Json
  improvement_metric     Float?

  @@schema("public")
}

model blackbook_auto_bet_config {
  id                    Int      @id @default(autoincrement())
  created_at            DateTime @db.Timestamptz(6)
  updated_at            DateTime @db.Timestamptz(6)
  user_id               String
  runner                String
  sport                 String
  bet_type              String
  stake                 Float
  enabled               Int      @default(1)
  probability_threshold Float    @default(50.0)
  notify_phone          String?
  notify_email          String?
  notify_pushover_key   String?

  @@unique([user_id, runner])
  @@schema("public")
}

model daily_strategy_runs {
  id                Int               @id @default(autoincrement())
  profile_key       String
  run_date          DateTime          @db.Date
  bankroll_standard Float             @default(250.00)
  bankroll_premium  Float             @default(500.00)
  total_allocated   Float?
  candidate_count   Int?
  selected_count    Int?
  skipped_count     Int?
  run_payload_json  Json?
  created_at        DateTime?         @default(now()) @db.Timestamptz(6)
  strategy_profiles strategy_profiles @relation(fields: [profile_key], references: [profile_key], onDelete: NoAction, onUpdate: NoAction)
  system_bets       system_bets[]

  @@unique([profile_key, run_date])
  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model paper_bet_log {
  id                Int          @id @default(autoincrement())
  created_at        DateTime     @default(now()) @db.Timestamptz(6)
  updated_at        DateTime     @default(now()) @db.Timestamptz(6)
  settled_at        DateTime?    @db.Timestamptz(6)
  prediction_log_id Int?
  sport             String
  event_id          String
  event_name        String
  selection         String
  bet_type          String
  odds              Float
  stake             Float
  status            String       @default("PENDING")
  payout            Float?
  profit            Float?
  notes             String?
  origin            String?      @default("user")
  system_bet_id     Int?
  user_id           String       @default("legacy")
  system_bets       system_bets? @relation(fields: [system_bet_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([created_at], map: "idx_paper_bet_log_created_at")
  @@index([sport, event_id], map: "idx_paper_bet_log_event")
  @@index([status], map: "idx_paper_bet_log_status")
  @@index([user_id, created_at], map: "idx_paper_bet_log_user_created_at")
  @@schema("public")
}

model prediction_log {
  id                  Int       @id @default(autoincrement())
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  updated_at          DateTime? @db.Timestamptz(6)
  sport               String
  event_id            String
  event_name          String
  selection           String
  probability         Float
  fair_odds           Float?
  payload_json        Json      @default("{}")
  feature_impact_json Json      @default("{}")
  actual_outcome      Float?
  result_status       String?
  settled_at          DateTime? @db.Timestamptz(6)

  @@unique([sport, event_id, selection], map: "idx_prediction_log_unique_selection")
  @@index([created_at], map: "idx_prediction_log_created_at")
  @@index([sport, event_id], map: "idx_prediction_log_event")
  @@index([settled_at], map: "idx_prediction_log_settled_at")
  @@index([sport], map: "idx_prediction_log_sport")
  @@schema("public")
}

model prediction_results {
  id                  Int      @id @default(autoincrement())
  created_at          DateTime @default(now()) @db.Timestamptz(6)
  updated_at          DateTime @default(now()) @db.Timestamptz(6)
  completed_at        DateTime @db.Timestamptz(6)
  sport               String
  event_id            String
  event_name          String
  winner_selection    String?
  result_payload_json Json     @default("{}")

  @@unique([sport, event_id], map: "idx_prediction_results_unique_event")
  @@schema("public")
}

model strategy_profiles {
  id                  Int                   @id @default(autoincrement())
  profile_key         String                @unique
  display_name        String
  rule_set_json       Json
  is_editable         Boolean?              @default(false)
  created_at          DateTime?             @default(now()) @db.Timestamptz(6)
  updated_at          DateTime?             @default(now()) @db.Timestamptz(6)
  daily_strategy_runs daily_strategy_runs[]

  @@schema("public")
}

model system_bets {
  id                  Int                 @id @default(autoincrement())
  run_id              Int
  profile_key         String
  sport               String
  event_id            String
  event_name          String
  market_type         String
  selection           String
  model_probability   Float
  odds_used           Float
  odds_source         String
  edge                Float
  stake               Float
  status              String              @default("pending")
  payout              Float?
  profit              Float?
  settled_at          DateTime?           @db.Timestamptz(6)
  created_at          DateTime?           @default(now()) @db.Timestamptz(6)
  legs_json           Json?
  paper_bet_log       paper_bet_log[]
  daily_strategy_runs daily_strategy_runs @relation(fields: [run_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([sport, event_id], map: "idx_system_bets_event")
  @@index([profile_key, created_at], map: "idx_system_bets_profile")
  @@index([run_id], map: "idx_system_bets_run")
  @@schema("public")
}

model weekly_retrain_log {
  id             Int      @id @default(autoincrement())
  run_date       DateTime @unique @db.Date
  started_at     DateTime @db.Timestamptz(6)
  completed_at   DateTime @db.Timestamptz(6)
  profile_count  Int
  tuned_profiles Int
  summary_json   Json     @default("{}")

  @@index([run_date], map: "idx_weekly_retrain_log_run_date")
  @@schema("public")
}

enum TriggerType {
  TRACK_CONDITION
  BARRIER_BOX
  JOCKEY_TRAINER
  ODDS_THRESHOLD
  ML_CONFIDENCE

  @@schema("public")
}

model Bankroll {
  id              String   @id @default(cuid())
  userId          String   @unique
  username        String   @default("Anonymous")
  balance         Float    @default(10000.0)
  startingBalance Float    @default(10000.0)
  monthlySpend    Float    @default(0.0)
  totalBetsPlaced Int      @default(0)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  @@schema("public")
}

model BlackbookItem {
  id               String          @id @default(cuid())
  userId           String
  targetType       String
  targetId         String
  targetName       String
  entityType       String          @default("RUNNER")
  notes            String?
  alertPreferences Json?           @default("{}") // { push: bool, email: bool, pushover: bool }
  rating           Int?            // 1-5 star personal rating
  conditions       Json            @default("{}") // { favourite: bool, tracks: [], minOdds: float, raceType: string, metro: bool, ... }
  jockeyName       String?
  trainerName      String?
  horseName        String?
  trackName        String?
  createdAt        DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime        @updatedAt @db.Timestamptz(6)
  rules            BlackbookRule[]

  @@unique([userId, targetId, targetType])
  @@schema("public")
}

model BlackbookRule {
  id              String        @id @default(cuid())
  blackbookItemId String
  triggerType     TriggerType
  operator        String        @default("EQUALS")
  triggerValue    String
  stakeAmount     Float         @default(10.0)
  stakeType       String        @default("WIN")
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(6)
  blackbookItem   BlackbookItem @relation(fields: [blackbookItemId], references: [id], onDelete: Cascade)

  @@schema("public")
}

model StrategyPerformanceLog {
  id          String   @id @default(cuid())
  strategyId  String
  runDate     DateTime @db.Date
  totalBets   Int
  winningBets Int
  totalStaked Float
  totalProfit Float
  roi         Float
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  @@unique([strategyId, runDate])
  @@schema("public")
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  username         String            @unique
  passwordHash     String
  emailConfirmed   Boolean           @default(false)
  marketingOptIn   Boolean           @default(false)
  startingBankroll Float             @default(10000.0)
  currentBankroll  Float             @default(10000.0)
  createdAt        DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(6)
  bets             Bet[]
  exoticBets       ExoticBet[]
  multiBets        MultiBet[]
  bankrollHistory  BankrollHistory[]

  @@schema("public")
}

model Bet {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventType        String
  eventId          String
  eventName        String
  eventTime        DateTime? @db.Timestamptz(6)
  betType          String
  selection        String
  odds             Float
  stake            Float
  status           String    @default("PENDING")
  payout           Float?
  wasAIRecommended Boolean   @default(false)
  notes            String?
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  settledAt        DateTime? @db.Timestamptz(6)

  @@index([userId, createdAt])
  @@index([status])
  @@schema("public")
}

model ExoticBet {
  id                String      @id @default(cuid())
  userId            String
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  betType           String
  eventName         String
  raceId            String?
  meetingId         String?
  stake             Float
  combinations      Int
  flexiPercentage   Float
  estimatedDividend Float?
  estimatedCollect  Float?
  poolStatus        String      @default("AWAITING_EXOTIC_POOL")
  status            String      @default("PENDING")
  legs              ExoticLeg[]
  createdAt         DateTime    @default(now()) @db.Timestamptz(6)
  settledAt         DateTime?   @db.Timestamptz(6)

  @@index([userId, createdAt])
  @@index([betType, status])
  @@schema("public")
}

model ExoticLeg {
  id            String    @id @default(cuid())
  exoticBetId   String
  exoticBet     ExoticBet @relation(fields: [exoticBetId], references: [id], onDelete: Cascade)
  raceId        String
  legNumber     Int       @default(1)
  position      Int?
  runnerId      String
  runnerName    String
  selectionMode String    @default("POSITIONAL")
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)

  @@index([exoticBetId, legNumber])
  @@index([raceId])
  @@schema("public")
}

model MultiBet {
  id                 String     @id @default(cuid())
  userId             String
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  multiType          String
  eventType          String
  eventId            String
  eventName          String
  stake              Float
  fairOdds           Float
  adjustedOdds       Float
  impliedProbability Float
  correlationHaircut Float
  calculationStatus  String     @default("CALCULATED")
  status             String     @default("PENDING")
  legs               MultiLeg[]
  createdAt          DateTime   @default(now()) @db.Timestamptz(6)
  settledAt          DateTime?  @db.Timestamptz(6)

  @@index([userId, createdAt])
  @@index([multiType, eventId])
  @@schema("public")
}

model MultiLeg {
  id               String   @id @default(cuid())
  multiBetId       String
  multiBet         MultiBet @relation(fields: [multiBetId], references: [id], onDelete: Cascade)
  marketType       String
  selectionId      String?
  selectionLabel   String
  odds             Float
  probability      Float
  correlationGroup String?
  line             Float?
  createdAt        DateTime @default(now()) @db.Timestamptz(6)

  @@index([multiBetId])
  @@schema("public")
}

model BankrollHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Float
  reason    String
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([userId, createdAt])
  @@schema("public")
}

model Syndicate {
  id            String             @id @default(cuid())
  name          String
  code          String             @unique
  ownerId       String
  buyInTier     Float              @default(50.0) // 20, 50, 100 paper currency
  paperBalance  Float              @default(0.0)
  maxStakeLimit Float              @default(50.0)
  createdAt     DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @db.Timestamptz(6)
  members       SyndicateMember[]
  ledgers       SyndicateLedger[]
  messages      SyndicateMessage[]

  @@schema("public")
}

model SyndicateMember {
  id          String    @id @default(cuid())
  syndicateId String
  userId      String
  username    String
  role        String    @default("MEMBER") // OWNER, ADMIN, MEMBER
  buyInAmount Float     @default(50.0)
  joinedAt    DateTime  @default(now()) @db.Timestamptz(6)
  syndicate   Syndicate @relation(fields: [syndicateId], references: [id], onDelete: Cascade)

  @@unique([syndicateId, userId])
  @@schema("public")
}

model SyndicateLedger {
  id          String    @id @default(cuid())
  syndicateId String
  userId      String
  type        String // BUY_IN, PAPER_BET, DIVIDEND, ADJUSTMENT
  amount      Float
  description String
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  syndicate   Syndicate @relation(fields: [syndicateId], references: [id], onDelete: Cascade)

  @@index([syndicateId, createdAt])
  @@schema("public")
}

model SyndicateMessage {
  id          String    @id @default(cuid())
  syndicateId String
  userId      String
  username    String
  text        String
  betPayload  Json?
  isSystem    Boolean   @default(false)
  isReported  Boolean   @default(false)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  syndicate   Syndicate @relation(fields: [syndicateId], references: [id], onDelete: Cascade)

  @@index([syndicateId, createdAt])
  @@schema("public")
}
