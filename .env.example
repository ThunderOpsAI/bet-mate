# ================================
# BetMate – Environment Variables
# ================================

# ---- App Environment ----
NODE_ENV=development

# ---- Database (Neon PostgreSQL) ----
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/betmate?sslmode=require

# ---- Local SQLite Fallback ----
# If DATABASE_URL is not set, SQLite is used at this path:
# BETMATE_DB_PATH=./runtime/betmate.sqlite3

# ---- CORS Origins ----
# Comma-separated list of allowed origins for the FastAPI backend
# In production, set this to your Vercel deployment URL
# Example: http://localhost:3000,http://127.0.0.1:3000,https://bet-mate-48zd2mjjk-james-projects-6ada824a.vercel.app
BETMATE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- ML Prediction Engine (FastAPI on Railway) ----
# Backend URL for the Next.js frontend to connect to
# Production: https://bet-mateprediction-engine-production.up.railway.app
NEXT_PUBLIC_ML_API=http://localhost:8000

# ---- External Data APIs ----
# Betfair (Racing) — get credentials at https://developer.betfair.com
BETFAIR_APP_KEY=your-betfair-app-key
BETFAIR_USERNAME=your-betfair-username
BETFAIR_PASSWORD=your-betfair-password
# Optional auth mode: auto | interactive | certificate
# `auto` tries certificate login first when cert material is configured, then falls back to interactive login.
BETFAIR_AUTH_MODE=auto
# Optional certificate login config for production bots.
# Use either file paths:
# BETFAIR_CERT_PATH=/app/secrets/betfair/client.crt
# BETFAIR_KEY_PATH=/app/secrets/betfair/client.key
# Or PEM content / base64-encoded PEM content:
# BETFAIR_CERT_PEM="-----BEGIN CERTIFICATE-----\n..."
# BETFAIR_KEY_PEM="-----BEGIN PRIVATE KEY-----\n..."
# BETFAIR_CERT_PEM_B64=base64-encoded-certificate-pem
# BETFAIR_KEY_PEM_B64=base64-encoded-private-key-pem

# Ball Don't Lie (NBA) — get a key at https://www.balldontlie.io
BDL_API_KEY=your-bdl-api-key

# Squiggle (AFL) — no key needed, uses User-Agent identification

# ---- Web App ----
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# ---- Blackbook Notifications ----
# Twilio (SMS) — sign up at https://twilio.com, free trial available
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+61...

# Resend (email) — sign up at https://resend.com, 100 emails/day free
RESEND_API_KEY=
NOTIFY_EMAIL_FROM=alerts@bet-mate.app

# Pushover (phone push notifications) — one-time $5 app purchase
# Create an app token at https://pushover.net/apps/build
# Each user installs the Pushover app and gets their own user key
PUSHOVER_APP_TOKEN=

# ---- Notes ----
# Do NOT commit real secrets.
# Use .env.local or .env.development for actual values.
# For Railway/Lightsail deployment, set env vars in the dashboard.
# For Vercel deployment, set NEXT_PUBLIC_ML_API to your Lightsail URL.
