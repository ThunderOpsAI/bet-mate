# ================================
# BetMate – Environment Variables
# ================================

# ---- App Environment ----
NODE_ENV=development

# ---- API Gateway ----
API_PORT=3001
JWT_SECRET=change-me-in-production

# ---- Database ----
DATABASE_URL=postgresql://user:password@localhost:5432/betmate

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- AI (Anthropic / Claude) ----
ANTHROPIC_API_KEY=sk-ant-xxxxx
ANTHROPIC_ORG_ID=org-xxxxx
CLAUDE_PROFILE=uni

# ---- External Data APIs ----
RACING_API_KEY=xxxxx
NBA_API_KEY=xxxxx
AFL_API_KEY=xxxxx

# ---- Web App ----
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# ---- Notes ----
# Do NOT commit real secrets.
# Use .env.local or .env.development for actual values.

