{
  "name": "bet-mate",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@9.1.0",
  "scripts": {
    "dev": "turbo dev",
    "dev:local-stack": "node scripts/dev-stack.mjs",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "db:generate": "pnpm --filter @bet-mate/prisma prisma:generate",
    "db:migrate": "pnpm --filter @bet-mate/prisma prisma:migrate",
    "db:push": "pnpm --filter @bet-mate/prisma prisma:push",
    "api:build:prod": "pnpm --filter @bet-mate/prisma prisma:generate && pnpm --filter @bet-mate/api build",
    "api:start:prod": "pnpm --filter @bet-mate/api start",
    "postinstall": "pnpm --filter @bet-mate/prisma prisma:generate"
  },
  "devDependencies": {
    "turbo": "^2.0.0"
  }
}
