{
  "version": 2,
  "installCommand": "pnpm install --frozen-lockfile && pnpm api:build:prod",
  "builds": [
    {
      "src": "src/index.ts",
      "use": "@vercel/node"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/settle-bets",
      "schedule": "0 14 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/src/index.ts"
    }
  ]
}
